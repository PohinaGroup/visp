#!/usr/bin/env bash
set -Eeuo pipefail

fail() {
	echo "visp-relay-release: $*" >&2
	exit 1
}

[[ $EUID -eq 0 ]] || fail "run as root"
[[ $# -ge 2 ]] || fail "usage: visp-relay-release <production|staging> [--force] <component>..."

readonly environment=$1
shift

case $environment in
	production)
		readonly repo=/opt/visp
		readonly suffix=
		readonly env_file=/etc/visp/relay.env
		readonly mediamtx_config=mediamtx.yml
		;;
	staging)
		readonly repo=/opt/visp-staging
		readonly suffix=-staging
		readonly env_file=/etc/visp-staging/relay.env
		readonly mediamtx_config=mediamtx-staging.yml
		;;
	*) fail "invalid environment: $environment" ;;
esac
readonly run_dir=/run/visp${suffix}

if [[ $environment == staging ]]; then
	exec 9>/run/lock/visp-relay-release.lock
	flock -w 1800 9 || fail "another relay release is still running"
fi

mediamtx=false
srtla=false
bond=false
caddy=false
# Restarting MediaMTX, srtla-rec or visp-bond drops every live stream and BRB
# hold on this relay; --force (or VISP_RELAY_RELEASE_FORCE=1) accepts that.
force=${VISP_RELAY_RELEASE_FORCE:-0}
components=()
for component in "$@"; do
	case $component in
		--force) force=1; continue ;;
		mediamtx) mediamtx=true ;;
		srtla-rec) srtla=true ;;
		visp-bond) bond=true ;;
		caddy) caddy=true ;;
		*) fail "invalid component: $component" ;;
	esac
	components+=("$component")
done
((${#components[@]} > 0)) || fail "no component given"
restarts=false
if $mediamtx || $srtla || $bond; then
	restarts=true
fi

for path in "$repo/.git" "$env_file"; do
	[[ -e $path ]] || fail "missing prerequisite: $path"
done
for command in cmake cc curl git make sha256sum systemctl; do
	command -v "$command" >/dev/null 2>&1 || fail "missing prerequisite: $command"
done
if $restarts; then
	command -v jq >/dev/null 2>&1 || fail "missing prerequisite: jq"
fi

# Forwarders put destination URLs (stream keys) in FFmpeg argv. hidepid is
# defence in depth per deploy/README.md, so its absence warns, not fails.
proc_options=$(awk '$2 == "/proc" && $3 == "proc" { print $4; exit }' /proc/mounts)
if ! [[ $proc_options =~ (^|,)hidepid=(1|2|noaccess|invisible)(,|$) ]]; then
	{
		echo "visp-relay-release: WARNING: /proc is not mounted with hidepid."
		echo "visp-relay-release: WARNING: local users can read stream keys from FFmpeg argv."
		echo "visp-relay-release: WARNING: see deploy/README.md (hidepid=invisible)."
	} >&2
fi

api_address=$(
	set -a
	# shellcheck disable=SC1090
	source "$env_file"
	printf '%s' "${MTX_APIADDRESS:-127.0.0.1:9997}"
)
readonly api_address

# Ingest paths only: studio/ and direct/ follow their ingest. Every page, since
# MediaMTX paginates the list.
active_paths() {
	local page=0 pages=1 body found count=0
	while ((page < pages)); do
		body=$(curl --fail --silent --max-time 5 \
			"http://$api_address/v3/paths/list?page=$page&itemsPerPage=1000") || return 1
		pages=$(jq -er '.pageCount // 1' <<<"$body") || return 1
		found=$(jq -e '[.items[]? | select(.name | test("^[A-Za-z0-9_-]+$"))
			| select(.ready or .source != null)] | length' <<<"$body") || return 1
		count=$((count + found))
		page=$((page + 1))
	done
	printf '%s' "$count"
}

# BRB cards outlive their path, so the API alone misses them.
held_forwarders() {
	local lock holder count=0
	for lock in "$run_dir"/fwd-*.lock; do
		[[ -d $lock ]] || continue
		holder=$(cat "$lock/pid" 2>/dev/null) || continue
		[[ -n $holder ]] && kill -0 "$holder" 2>/dev/null && count=$((count + 1))
	done
	printf '%s' "$count"
}

if $restarts; then
	if live=$(active_paths); then
		echo "visp-relay-release: $live active ingest path(s) on $api_address"
	else
		live=0
		echo "visp-relay-release: MediaMTX API at $api_address did not answer; assuming no live paths" >&2
	fi
	held=$(held_forwarders)
	echo "visp-relay-release: $held running forwarder(s) or BRB hold(s)"
	if ((live + held > 0)); then
		[[ $force == 1 ]] ||
			fail "restart would drop $live live path(s) and $held forwarder(s); rerun with --force"
		echo "visp-relay-release: --force given; live streams will be dropped" >&2
	fi
fi

work=$(mktemp -d /var/tmp/visp-relay-release.XXXXXX)
readonly work
trap 'rm -rf "$work"' EXIT

if $caddy; then
	[[ $environment == production ]] || fail "caddy component is production-only; staging uses the app Caddyfile"
	[[ -f /etc/visp/caddy.env ]] || fail "missing prerequisite: /etc/visp/caddy.env"
	command -v caddy >/dev/null || fail "missing prerequisite: caddy"
	install -d /etc/caddy/staging
	touch /etc/caddy/staging/.empty.caddy
	(
		set -a
		source /etc/visp/caddy.env
		set +a
		caddy validate --config "$repo/deploy/relay/Caddyfile" --adapter caddyfile
	)
	install -m 0644 "$repo/deploy/relay/Caddyfile" /etc/caddy/Caddyfile
	install -D -m 0644 "$repo/deploy/systemd/caddy-relay.conf" /etc/systemd/system/caddy.service.d/visp.conf
	systemctl daemon-reload
	systemctl reload caddy
fi

if $mediamtx; then
	# shellcheck disable=SC1091
	source "$repo/deploy/relay/mediamtx.version"
	[[ $(uname -m) == x86_64 ]] || fail "MediaMTX automation supports x86_64 only"
	readonly archive="mediamtx_v${MEDIAMTX_VERSION}_linux_amd64.tar.gz"
	curl -fL "https://github.com/bluenviron/mediamtx/releases/download/v${MEDIAMTX_VERSION}/$archive" \
		-o "$work/$archive"
	echo "$MEDIAMTX_LINUX_AMD64_SHA256  $work/$archive" | sha256sum -c -
	tar -xzf "$work/$archive" -C "$work" mediamtx
fi

if $srtla; then
	srtla_commit=$(sed -n 's/^ARG SRTLA_COMMIT=//p' \
		"$repo/deploy/relay/srtla-rec/Dockerfile")
	readonly srtla_commit
	[[ $srtla_commit =~ ^[0-9a-f]{40}$ ]] || fail "invalid pinned SRTLA commit"
	git clone --quiet https://github.com/BELABOX/srtla.git "$work/srtla"
	git -C "$work/srtla" checkout --quiet "$srtla_commit"
	make -C "$work/srtla" srtla_rec
fi

if $bond; then
	srt_version=$(sed -n 's/^ARG SRT_VERSION=//p' \
		"$repo/deploy/relay/visp-bond/Dockerfile")
	readonly srt_version
	srt_sha256=$(sed -n 's/^ARG SRT_SHA256=//p' \
		"$repo/deploy/relay/visp-bond/Dockerfile")
	readonly srt_sha256
	[[ $srt_version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "invalid pinned SRT version"
	[[ $srt_sha256 =~ ^[0-9a-f]{64}$ ]] || fail "invalid pinned SRT checksum"
	curl -fL "https://github.com/Haivision/srt/archive/refs/tags/v${srt_version}.tar.gz" \
		-o "$work/srt.tar.gz"
	echo "$srt_sha256  $work/srt.tar.gz" | sha256sum -c -
	mkdir "$work/srt"
	tar -xzf "$work/srt.tar.gz" -C "$work/srt" --strip-components=1
	cmake -S "$work/srt" -B "$work/srt/build" \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr/local \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DENABLE_APPS=OFF \
		-DENABLE_BONDING=ON \
		-DENABLE_ENCRYPTION=ON \
		-DUSE_ENCLIB=mbedtls
	cmake --build "$work/srt/build" --parallel 2
	cmake -S "$repo/deploy/relay/visp-bond" -B "$work/visp-bond" \
		-DCMAKE_BUILD_TYPE=Release \
		-DSRT_INCLUDE_DIR="$work/srt" \
		-DSRT_LIBRARY="$work/srt/build/libsrt.so"
	cmake --build "$work/visp-bond" --parallel 2
fi

if $mediamtx; then
	install -m 0755 "$work/mediamtx" /usr/local/bin/mediamtx
	install -D -m 0755 "$repo/deploy/relay/visp-snapshot" \
		/usr/local/libexec/visp-snapshot
	install -D -m 0644 "$repo/deploy/relay/$mediamtx_config" \
		"/etc/mediamtx/$mediamtx_config"
	install -m 0644 "$repo/deploy/systemd/mediamtx${suffix}.service" \
		"/etc/systemd/system/mediamtx${suffix}.service"
	# Host metrics for VISP Admin. Production only: a staging relay would need
	# its own RELAY_NAME registered before the report has anywhere to land.
	if [[ $environment == production ]]; then
		install -D -m 0755 "$repo/deploy/relay/visp-relay-health" \
			/usr/local/libexec/visp-relay-health
		install -m 0644 "$repo/deploy/systemd/visp-relay-health.service" \
			/etc/systemd/system/visp-relay-health.service
		install -m 0644 "$repo/deploy/systemd/visp-relay-health.timer" \
			/etc/systemd/system/visp-relay-health.timer
	fi
fi
if $srtla; then
	install -m 0755 "$work/srtla/srtla_rec" /usr/local/bin/srtla_rec
	install -m 0644 "$repo/deploy/systemd/srtla-rec${suffix}.service" \
		"/etc/systemd/system/srtla-rec${suffix}.service"
fi
if $bond; then
	cmake --install "$work/srt/build"
	ldconfig
	install -m 0755 "$work/visp-bond/visp-bond" /usr/local/bin/visp-bond
	install -m 0644 "$repo/deploy/systemd/visp-bond${suffix}.service" \
		"/etc/systemd/system/visp-bond${suffix}.service"
fi

systemctl daemon-reload
if $mediamtx && [[ $environment == production ]]; then
	systemctl enable --now visp-relay-health.timer
fi
if $mediamtx; then
	systemctl restart "mediamtx${suffix}"
	systemctl restart "srtla-rec${suffix}" "visp-bond${suffix}"
else
	$srtla && systemctl restart "srtla-rec${suffix}"
	$bond && systemctl restart "visp-bond${suffix}"
fi

systemctl is-active --quiet "mediamtx${suffix}" \
	"srtla-rec${suffix}" "visp-bond${suffix}"
curl --retry 20 --retry-delay 1 --retry-connrefused --fail --silent \
	"http://$api_address/v3/paths/list" >/dev/null

echo "VISP relay ($environment): ${components[*]} deployed"
