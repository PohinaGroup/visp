{$APP_DOMAIN} {
	route {
		@machine {
			path /api/mediamtx/auth /api/hooks/*
			remote_ip {$RELAY_PUBLIC_IPS}
		}
		handle @machine {
			reverse_proxy 127.0.0.1:3000
		}

		@blocked_machine path /api/mediamtx/auth /api/hooks/*
		handle @blocked_machine {
			respond 403
		}

		handle /api/auth/* {
			reverse_proxy 127.0.0.1:3000
		}
		handle /trpc/* {
			reverse_proxy 127.0.0.1:3000
		}
		handle /api/chat/* {
			reverse_proxy 127.0.0.1:3000
		}
		handle /api/seppo {
			reverse_proxy 127.0.0.1:3000 {
				header_up X-Real-IP {remote_host}
			}
		}
		handle /api/obs/* {
			reverse_proxy 127.0.0.1:3000
		}
		handle /api/tts {
			reverse_proxy 127.0.0.1:3000
		}
		handle /api/audio-isolation {
			reverse_proxy 127.0.0.1:3000
		}
		handle /api/webhooks/kick {
			reverse_proxy 127.0.0.1:3000
		}
		handle {
			reverse_proxy 127.0.0.1:3001
		}
	}
}

{$ADMIN_DOMAIN} {
	root * /opt/visp/apps/admin/dist
	encode zstd gzip
	try_files {path} /index.html
	file_server
}

{$NATIVE_WEB_DOMAIN} {
	root * /opt/visp/apps/native/dist
	encode zstd gzip
	try_files {path} /index.html
	file_server
}

{$OBS_REMOTE_WEB_DOMAIN} {
	root * /opt/visp/apps/obs-remote/dist
	encode zstd gzip
	try_files {path} /index.html
	file_server
}

{$DOCS_DOMAIN} {
	root * /opt/visp/apps/fumadocs/.output/public
	encode zstd gzip

	handle /api/* {
		header Content-Type application/json
		file_server
	}

	handle {
		try_files {path} {path}/index.html /_shell.html
		file_server
	}
}
