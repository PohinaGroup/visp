# Every browser-facing vhost imports these. HSTS covers subdomains because
# every visp-stream.com host is served by Caddy over HTTPS.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

(deny_framing) {
	header {
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
	}
}

# Proxied API bodies are small JSON; uploads go straight to object storage
# via presigned URLs. Typography saves carry a whole word-level transcript,
# and audio isolation chunks are ISOLATION_MAX_BYTES (32 KB) of PCM.
(api_body_limits) {
	@json_api {
		path /api/* /trpc/* /.well-known/agent-configuration
		not path /api/audio-isolation /api/typography/*
	}
	request_body @json_api {
		max_size 1MiB
	}
	request_body /api/typography/* {
		max_size 8MiB
	}
	request_body /api/audio-isolation {
		max_size 64KiB
	}
}

{$APP_DOMAIN} {
	import security_headers
	# OBS loads /overlay as a top-level browser source, and /live is the
	# always-on broadcast page; the Cloud Studio editor previews browser
	# layers in an iframe on this origin, so both allow same-origin framing.
	@overlay path /overlay /live /live/
	header @overlay {
		X-Frame-Options SAMEORIGIN
		Content-Security-Policy "frame-ancestors 'self'"
	}
	@not_overlay not path /overlay /live /live/
	header @not_overlay {
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
	}

	route {
		import api_body_limits

		@machine {
			path /api/mediamtx/auth /api/hooks/*
			remote_ip {$RELAY_PUBLIC_IPS}
		}
		handle @machine {
			reverse_proxy 127.0.0.1:3000
		}

		@blocked_machine path /api/mediamtx/auth /api/hooks/*
		handle @blocked_machine {
			respond 403
		}

		handle /api/auth/* {
			reverse_proxy 127.0.0.1:3000
		}
		handle /api/agent/* {
			reverse_proxy 127.0.0.1:3000
		}
		handle /.well-known/agent-configuration {
			reverse_proxy 127.0.0.1:3000
		}
		handle /trpc/* {
			reverse_proxy 127.0.0.1:3000
		}
		handle /api/chat/* {
			reverse_proxy 127.0.0.1:3000
		}
		handle /api/multichat/* {
			reverse_proxy 127.0.0.1:3000
		}
		handle /chat {
			redir https://{$MULTICHAT_DOMAIN}/ 308
		}
		handle_path /chat/* {
			redir https://{$MULTICHAT_DOMAIN}{uri} 308
		}
		handle /api/seppo {
			reverse_proxy 127.0.0.1:3000 {
				header_up X-Real-IP {remote_host}
			}
		}
		handle /api/obs/* {
			reverse_proxy 127.0.0.1:3000
		}
		handle /api/subtitles/token {
			reverse_proxy 127.0.0.1:3000
		}
		handle /api/typography/* {
			reverse_proxy 127.0.0.1:3000
		}
		handle /api/tts {
			reverse_proxy 127.0.0.1:3000
		}
		handle /api/audio-isolation {
			reverse_proxy 127.0.0.1:3000
		}
		handle /api/webhooks/* {
			reverse_proxy 127.0.0.1:3000
		}
		handle {
			reverse_proxy 127.0.0.1:3001
		}
	}
}

{$ADMIN_DOMAIN} {
	import security_headers
	import deny_framing
	root * /opt/visp/apps/admin/dist
	encode zstd gzip
	try_files {path} /index.html
	file_server
}

{$TYPOGRAPHY_DOMAIN} {
	import security_headers
	import deny_framing
	root * /opt/visp/apps/typography/dist
	encode zstd gzip
	try_files {path} /index.html
	file_server
}

{$MULTICHAT_DOMAIN} {
	import security_headers
	# The overlay is an OBS browser source and may be previewed in the Cloud
	# Studio editor on the app origin; nothing else may frame it.
	header Content-Security-Policy "frame-ancestors https://{$APP_DOMAIN}"
	root * /opt/visp/apps/multichat/dist
	encode zstd gzip
	try_files {path} /index.html
	file_server
}

{$NATIVE_WEB_DOMAIN} {
	import security_headers
	import deny_framing
	root * /opt/visp/apps/native/dist
	encode zstd gzip
	try_files {path} /index.html
	file_server
}

{$OBS_REMOTE_WEB_DOMAIN} {
	import security_headers
	import deny_framing
	root * /opt/visp/apps/obs-remote/dist
	encode zstd gzip
	try_files {path} /index.html
	file_server
}

{$DOCS_DOMAIN} {
	import security_headers
	import deny_framing
	root * /opt/visp/apps/fumadocs/.output/public
	encode zstd gzip

	handle /api/* {
		header Content-Type application/json
		file_server
	}

	handle {
		try_files {path} {path}/index.html /_shell.html
		file_server
	}
}

# Staging vhosts live in /etc/caddy/staging/*.caddy so production releases can
# replace this file without touching them. The directory must exist with at
# least one .caddy file (Caddy errors on an unmatched import glob);
# deploy/visp-release creates the placeholder automatically.
import /etc/caddy/staging/*.caddy
