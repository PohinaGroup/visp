#!/usr/bin/env bash
set -Eeuo pipefail

readonly repo=/opt/visp
readonly bun=/usr/local/bin/bun
readonly app_env=/etc/visp/app.env
readonly web_env=/etc/visp/web.env
readonly native_web_env=/etc/visp/native-web.env
readonly obs_remote_web_env=/etc/visp/obs-remote-web.env
readonly caddy_env=/etc/visp/caddy.env

fail() {
	echo "visp-release: $*" >&2
	exit 1
}

[[ $EUID -eq 0 ]] || fail "run as root"
[[ $# -eq 2 ]] || fail "usage: visp-release <vX.Y.Z> <40-character-commit-sha>"

readonly tag=$1
readonly expected_sha=$2

[[ $tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "invalid release tag: $tag"
[[ $expected_sha =~ ^[0-9a-f]{40}$ ]] || fail "invalid commit SHA"

for path in "$repo/.git" "$bun" "$app_env" "$web_env" "$native_web_env" \
	"$obs_remote_web_env" "$caddy_env"; do
	[[ -e $path ]] || fail "missing prerequisite: $path"
done

run_with_env() (
	local env_file=$1
	shift
	set -a
	# Environment files are root-owned deployment inputs.
	# shellcheck disable=SC1090
	source "$env_file"
	set +a
	"$@"
)

readonly actual_sha=$(git -C "$repo" rev-parse HEAD)
[[ $actual_sha == "$expected_sha" ]] ||
	fail "$repo is at $actual_sha, expected $expected_sha"
if ! git -C "$repo" diff --quiet ||
	! git -C "$repo" diff --cached --quiet; then
	fail "$repo has tracked changes"
fi

"$bun" install --cwd "$repo" --frozen-lockfile

# Fail before migrating or swapping the live service if app.env no longer
# satisfies the server env schema (e.g. a newly required var shipped in code).
# Reuses the same createEnv the server runs at boot, so it can't drift.
(cd "$repo" && run_with_env "$app_env" "$bun" -e 'await import("@VISP/env/server")')

run_with_env "$app_env" "$bun" run --cwd "$repo" db:migrate
(
	cd "$repo"
	run_with_env "$web_env" "$bun" x turbo run build -F server -F web -F admin
)
run_with_env "$native_web_env" "$bun" run --cwd "$repo/apps/native" build:web
run_with_env "$obs_remote_web_env" "$bun" run --cwd "$repo/apps/obs-remote" build:web
"$bun" run --cwd "$repo/apps/fumadocs" build

for output in \
	apps/admin/dist/index.html \
	apps/native/dist/index.html \
	apps/obs-remote/dist/index.html \
	apps/fumadocs/.output/public/_shell.html \
	apps/fumadocs/.output/public/docs/index.html \
	apps/fumadocs/.output/public/docs/broadcaster-setup/index.html \
	apps/fumadocs/.output/public/docs/self-hosting/index.html \
	apps/fumadocs/.output/public/docs/development/index.html \
	apps/fumadocs/.output/public/api/search \
	apps/fumadocs/.output/public/llms.txt \
	apps/fumadocs/.output/public/llms-full.txt; do
	[[ -f "$repo/$output" ]] || fail "build did not produce $output"
done

(
	set -a
	# shellcheck disable=SC1090
	source "$caddy_env"
	set +a
	caddy validate --config "$repo/deploy/app/Caddyfile" --adapter caddyfile
)
install -m 0644 "$repo/deploy/app/Caddyfile" /etc/caddy/Caddyfile
install -m 0644 "$repo/deploy/systemd/visp-server.service" \
	/etc/systemd/system/visp-server.service
install -m 0644 "$repo/deploy/systemd/visp-web.service" \
	/etc/systemd/system/visp-web.service
systemctl daemon-reload

systemctl restart visp-server visp-web
systemctl reload caddy
systemctl is-active --quiet visp-server visp-web caddy

if ! curl --retry 30 --retry-delay 1 --retry-max-time 30 --retry-connrefused \
	--fail --silent --show-error http://127.0.0.1:3000/ >/dev/null; then
	echo "visp-release: visp-server did not become ready on :3000" >&2
	systemctl --no-pager --full status visp-server >&2 || true
	journalctl -u visp-server -n 80 --no-pager >&2 || true
	exit 1
fi
if ! curl --retry 30 --retry-delay 1 --retry-max-time 30 --retry-connrefused \
	--fail --silent --show-error http://127.0.0.1:3001/ >/dev/null; then
	echo "visp-release: visp-web did not become ready on :3001" >&2
	systemctl --no-pager --full status visp-web >&2 || true
	journalctl -u visp-web -n 80 --no-pager >&2 || true
	exit 1
fi

echo "VISP $tag ($expected_sha) deployed"
