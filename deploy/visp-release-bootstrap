#!/usr/bin/env bash
set -Eeuo pipefail

readonly repo=/opt/visp
readonly helper=/usr/local/libexec/visp-release

fail() {
	echo "visp-release: $*" >&2
	exit 1
}

# Names the offending files: a bare "has tracked changes" is undebuggable
# without SSH access to the box.
assert_clean() {
	git -C "$repo" diff --quiet && git -C "$repo" diff --cached --quiet && return
	git -C "$repo" status --porcelain --untracked-files=no >&2
	fail "$*"
}

[[ $EUID -eq 0 ]] || fail "run as root"
# Releases since the CI-built site bundle take its path as a third argument;
# older tags' helpers build on the host and take two.
[[ $# -eq 2 || $# -eq 3 ]] ||
	fail "usage: visp-release <vX.Y.Z> <40-character-commit-sha> [visp-sites.tar.gz]"

readonly tag=$1
readonly expected_sha=$2

[[ $tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "invalid release tag: $tag"
[[ $expected_sha =~ ^[0-9a-f]{40}$ ]] || fail "invalid commit SHA"
git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
	fail "$repo is not a Git repository"

exec 9>/run/lock/visp-release.lock
flock -w 1800 9 || fail "another release is still running"

assert_clean "$repo has tracked changes before checkout; run" \
	"'git -C $repo checkout -- .' on the host after reviewing them"

git -C "$repo" fetch --force --prune origin \
	"refs/tags/$tag:refs/tags/$tag"
actual_sha=$(git -C "$repo" rev-parse "$tag^{commit}")
readonly actual_sha
[[ $actual_sha == "$expected_sha" ]] ||
	fail "$tag resolves to $actual_sha, expected $expected_sha"

git -C "$repo" checkout --detach "$expected_sha"
assert_clean "$repo checkout left tracked changes;" \
	"repair its ownership and permissions"

install -D -m 0755 "$repo/deploy/visp-release" "$helper"
exec "$helper" "$@"
