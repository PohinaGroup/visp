#!/usr/bin/env bash

set -u

app_url="${1%/}"
path="$2"
source_type="${3:-}"

# Slugs are generated by the app, but this one lands in file paths, so it is
# treated as untrusted input rather than assumed safe.
safe_path="$(printf '%s' "$path" | tr -cd 'A-Za-z0-9_-')"
run_dir="${VISP_RUN_DIR:-/run/visp}"
mkdir -p "$run_dir" 2>/dev/null || true
# Holds this script's pid. A forwarder that outlived us reads it to tell an
# ingest drop (we are gone) from a destination failure (we are still here).
live_marker="$run_dir/$safe_path.live"
snapshot_file="$run_dir/$safe_path.jpg"

# MediaMTX starts runOnAvailable with Setpgid, so this script leads its own
# process group and "kill 0" reaches the snapshot grab without touching
# MediaMTX itself.
#
# Forwarders are deliberately NOT in this group: each is started under "set -m"
# so job control gives it a group of its own, and it survives the teardown
# below to hold the platform broadcast open on the BRB card. Their lock dirs are
# what stops runOnAvailableRestart from starting a second one against the same
# stream key. Do not wrap the snapshot loop in "set -m" as well — "kill 0" would
# then reach nothing.
#
# The snapshot file outlives us on purpose: it is the BRB card's background.
trap 'trap - INT TERM EXIT; rm -f "$live_marker"; kill 0 2>/dev/null; exit 0' \
	INT TERM EXIT

printf '%s\n' "$$" >"$live_marker"

# Distribution encode knobs. Calibration values, not constants: the encoder and
# the bitrate come out of measuring CPU per forwarder on the real box.
video_encoder="${DIRECT_VIDEO_ENCODER:-libx264}"
video_bitrate_kbps="${DIRECT_VIDEO_BITRATE_KBPS:-6000}"
video_fps="${DIRECT_VIDEO_FPS:-30}"

# BRB card knobs. The live branch passes the publisher's resolution through
# untouched, so a card at a different size means the platform opens a new
# encoding session on the swap — harmless at these reconnect times, and the
# knobs are here for anyone who wants them matched.
brb_width="${BRB_WIDTH:-1920}"
brb_height="${BRB_HEIGHT:-1080}"
brb_font="${BRB_FONT:-/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf}"
brb_tick_seconds="${BRB_TICK_SECONDS:-15}"
# ponytail: a stuck-process ceiling, not a product limit. The app owns the stop
# decision and answers every tick; this only bounds a forwarder whose app went
# away entirely. Raise it if someone legitimately holds a card for a day.
brb_max_seconds="${BRB_MAX_SECONDS:-21600}"

hook() {
	curl --fail --silent --show-error --max-time 2 --request POST \
		--header "Content-Type: application/json" \
		--header "X-Hook-Secret: $HOOK_SECRET" \
		--data "$2" \
		"$app_url/api/hooks/$1" >/dev/null
}

# Strips everything that could carry a URL, a key, or a JSON escape, so the
# reported reason is safe to store and safe to show. The app sanitizes again.
safe_reason() {
	printf '%s' "${1:-}" | tr -cd 'A-Za-z0-9 .,:()_-' | cut -c1-160
}

report_state() {
	hook direct-state \
		"{\"path\":\"$path\",\"provider\":\"$1\",\"state\":\"$2\",\"role\":\"${4:-landscape}\",\"error\":\"$(safe_reason "${3:-}")\"}" \
		|| true
}

lock_dir() {
	printf '%s/fwd-%s-%s.lock' "$run_dir" "$safe_path" "$1"
}

# The pid of a forwarder still holding this provider, or nothing. A lock with no
# pid file yet is a forwarder mid-spawn, so it counts as held: treating it as
# stale is what would double-publish.
lock_holder() {
	local holder
	holder="$(cat "$(lock_dir "$1")/pid" 2>/dev/null)" || return 1
	test -n "$holder" || return 0
	kill -0 "$holder" 2>/dev/null || return 1
	printf '%s' "$holder"
}

# mkdir is the atomic part. A lock whose pid is gone belongs to a forwarder the
# kernel killed without letting its trap run (relay reboot, OOM).
acquire_lock() {
	local lock
	lock="$(lock_dir "$1")"
	mkdir "$lock" 2>/dev/null && return 0
	lock_holder "$1" >/dev/null && return 1
	rm -rf "$lock"
	mkdir "$lock" 2>/dev/null
}

# True while the publisher is still connected: our own pid is in the marker, so
# this stays correct even when the script is killed without running its trap.
ingest_live() {
	local owner
	owner="$(cat "$live_marker" 2>/dev/null)" || return 1
	test -n "$owner" && kill -0 "$owner" 2>/dev/null
}

# Always distribution-encode. Never "-c:v copy": stream-copying would ship the
# phone's contribution bitstream to the platform and skip the encode Direct
# exists to own. RTMP/FLV also carries only H.264 + AAC, and both native
# encoders currently emit mono at different sample rates, so this fixed audio
# encode is what makes Kick's stereo requirement hold for every client version
# without a store release.
#
# ponytail: the destination sits in argv because FFmpeg has no non-argv form for
# an output URL. /proc/PID/cmdline is world-readable, so the relay must run as a
# dedicated user with hidepid on /proc — see deploy/README.md. Revisit if FFmpeg
# grows an env or stdin form.
#
# "$1" is "exec" when the caller backgrounds this. Without it the background job
# is a shell with FFmpeg as its foreground child, and a shell sits on SIGTERM
# until that child returns — so the BRB card would outlive the reconnect and
# double-publish against the same stream key.
encode_to() {
	local mode="$1" destination="$2" log="$3"
	local -a command
	shift 3
	command=(ffmpeg -nostdin -hide_banner -loglevel error \
		"$@" \
		-c:v "$video_encoder" -preset veryfast -profile:v main \
		-pix_fmt yuv420p -r "$video_fps" \
		-b:v "${video_bitrate_kbps}k" -maxrate "${video_bitrate_kbps}k" \
		-bufsize "$((video_bitrate_kbps * 2))k" \
		-g "$((video_fps * 2))" -keyint_min "$((video_fps * 2))" \
		-c:a aac -ac 2 -b:a 128k -ar 48000 \
		-f flv "$destination")
	if test -n "$mode"; then
		exec "${command[@]}" 2>"$log"
	else
		"${command[@]}" 2>"$log"
	fi
}

cleanup_forward() {
	local child
	trap - INT TERM EXIT
	rm -f "$log"
	rm -rf "$lock"
	for child in ${desired_watcher:-} ${watcher:-} ${encoder_pid:-} ${brb_pid:-}; do
		kill "$child" 2>/dev/null || true
	done
	for child in ${desired_watcher:-} ${watcher:-} ${encoder_pid:-} ${brb_pid:-}; do
		wait "$child" 2>/dev/null || true
	done
}

# Asks the app whether this forwarder should still be holding, and with what.
# One line: "stop", or "brb <message-base64> <background-url|-> <source>".
brb_tick() {
	curl --fail --silent --show-error --max-time 5 --request POST \
		--header "Content-Type: application/json" \
		--header "X-Hook-Secret: $HOOK_SECRET" \
		--data "{\"path\":\"$path\",\"provider\":\"$1\"}" \
		"$app_url/api/hooks/brb"
}

# One destination, one FFmpeg process, one retry loop. A failure here never
# touches the other provider: each forwarder runs as its own background job.
#
# The loop outlives the script. When the ingest drops it swaps the live encode
# for the BRB card against the same destination URL — a sub-second RTMP
# reconnect, well inside every platform's grace window, so the broadcast, the
# hosts and the VOD survive what used to end the stream.
forward() {
	local provider="$1" role="$2" filter="$3" destination="$4" desired_state="$5"
	local backoff started reason
	# log and lock are deliberately not local: the signal handler and final
	# cleanup share them after the current encode attempt has returned.
	# Each forwarder is its own subshell, so these cannot collide.
	# Job control was only ever needed to give this subshell a group of its own.
	# Leaving it on would put every FFmpeg in a group of its own too, and the
	# trap below could no longer reap them.
	set +m
	lock="$(lock_dir "$provider")"
	log="$(mktemp)"
	backoff=2

	# Its own group, so it reaps its own FFmpeg and nothing else.
	watcher=""
	desired_watcher=""
	encoder_pid=""
	trap 'cleanup_forward; exit 0' INT TERM
	trap cleanup_forward EXIT
	# Raised by the next runOnAvailable: the publisher is back.
	resume=0
	brb_pid=""
	trap 'resume=1; test -n "$brb_pid" && kill "$brb_pid" 2>/dev/null' USR1
	if test "$desired_state" = 1; then
		(
			while sleep 2; do
				curl --fail --silent --max-time 2 --request POST \
					--header "Content-Type: application/json" \
					--header "X-Hook-Secret: $HOOK_SECRET" \
					--data "{\"path\":\"$path\",\"provider\":\"$provider\",\"role\":\"$role\",\"filter\":\"$filter\"}" \
					"$app_url/api/hooks/direct-active" >/dev/null && continue
				touch "$lock/stop"
				encoder_pid="$(cat "$lock/encoder-pid" 2>/dev/null)" || break
				kill -TERM "$encoder_pid" 2>/dev/null
				for _ in {1..50}; do
					kill -0 "$encoder_pid" 2>/dev/null || break
					sleep 0.1
				done
				if kill -0 "$encoder_pid" 2>/dev/null &&
					! kill -KILL "$encoder_pid" 2>/dev/null; then
					report_state "$provider" stopping "encoder did not exit" "$role"
				fi
				break
			done
		) &
		desired_watcher="$!"
	fi

	report_state "$provider" starting "" "$role"

	while true; do
		started="$SECONDS"
		# Promote to live only once the destination has held for a while;
		# a rejected stream key fails well inside this window.
		( sleep 10; report_state "$provider" live "" "$role" ) &
		watcher="$!"
		if test "$role" = portrait; then
			encode_to exec "$destination" "$log" \
				-rtsp_transport tcp -i "rtsp://127.0.0.1:$RTSP_PORT/$path" \
				-vf "$filter" &
		else
			encode_to exec "$destination" "$log" \
				-rtsp_transport tcp -i "rtsp://127.0.0.1:$RTSP_PORT/$path" &
		fi
		encoder_pid="$!"
		printf '%s\n' "$encoder_pid" >"$lock/encoder-pid"
		wait "$encoder_pid" 2>/dev/null
		kill "$watcher" 2>/dev/null
		wait "$watcher" 2>/dev/null
		watcher=""
		if kill -0 "$encoder_pid" 2>/dev/null; then
			report_state "$provider" stopping "encoder did not exit" "$role"
			encoder_pid=""
			exit 1
		fi
		encoder_pid=""
		reason="$(tail -n 1 "$log" 2>/dev/null)"
		if test -f "$lock/stop"; then
			wait "$desired_watcher" 2>/dev/null
			desired_watcher=""
			break
		fi

		if ! ingest_live; then
			# The source is gone, not the destination. Hold the broadcast open
			# until the publisher returns or the app says stop.
			hold_brb "$provider" "$destination" "$log" || break
			backoff=2
			continue
		fi

		# A running retry loop still owns its encoder slot. Provider consent
		# failures are reported before a forwarder is started.
		test "$((SECONDS - started))" -lt 60 || backoff=2
		report_state "$provider" retrying "$reason" "$role"
		sleep "$backoff" &
		wait "$!"
		backoff="$((backoff * 2))"
		test "$backoff" -le 60 || backoff=60
	done

	report_state "$provider" stopped "" "$role"
	cleanup_forward
	exit 0
}

# Writes the card the viewer sees. The message arrives base64-encoded and goes
# to a file that FFmpeg reads with textfile=, so user text never becomes a shell
# word and never needs filtergraph escaping.
prepare_card() {
	local message_b64="$1" url="$2" source="$3" text_file="$4" image_file="$5"
	printf '%s' "$message_b64" | base64 -d >"$text_file" 2>/dev/null ||
		printf 'Be right back' >"$text_file"
	test -s "$text_file" || printf 'Be right back' >"$text_file"

	# Our own grab is the same frame the app would hand back, minus a round
	# trip, and it survives the object store being the thing that is down.
	if test "$source" = snapshot && test -s "$snapshot_file"; then
		cp "$snapshot_file" "$image_file" 2>/dev/null && return 0
	fi
	test "$url" != "-" || return 1
	curl --fail --silent --show-error --max-time 10 \
		--output "$image_file" "$url" 2>/dev/null &&
		test -s "$image_file"
}

brb_card_ffmpeg() {
	local destination="$1" log="$2" image="$3" source="$4" text_file="$5"
	local filter
	local -a input
	if test -n "$image"; then
		input=(-re -loop 1 -framerate "$video_fps" -i "$image")
		filter="scale=$brb_width:$brb_height:force_original_aspect_ratio=decrease"
		filter="$filter,pad=$brb_width:$brb_height:(ow-iw)/2:(oh-ih)/2"
		# The snapshot grab is 640 wide, so it arrives upscaled. Blurring reads
		# as a deliberate "paused" card instead of a soft frame.
		test "$source" = snapshot && filter="$filter,boxblur=12:2"
	else
		input=(-re -f lavfi
			-i "color=c=black:s=${brb_width}x${brb_height}:r=$video_fps")
		filter="null"
	fi
	# A card with no text still beats no card, so a missing font is not fatal.
	if test -r "$brb_font"; then
		filter="$filter,drawtext=textfile=$text_file:fontfile=$brb_font"
		filter="$filter:fontcolor=white:fontsize=$((brb_height / 14))"
		filter="$filter:box=1:boxcolor=black@0.5:boxborderw=24"
		filter="$filter:x=(w-text_w)/2:y=(h-text_h)/2"
	fi
	encode_to exec "$destination" "$log" \
		"${input[@]}" \
		-re -f lavfi -i "anullsrc=channel_layout=stereo:sample_rate=48000" \
		-vf "$filter"
}

# Holds the destination open on the BRB card. Returns 0 when the publisher came
# back and the caller should go straight to the live encode, 1 when this
# forwarder is done.
hold_brb() {
	local provider="$1" destination="$2" log="$3"
	local text_file image_file entered line verb card_started card_image
	text_file="$run_dir/$safe_path-$provider.txt"
	image_file="$run_dir/$safe_path-$provider.img"
	entered="$SECONDS"
	resume=0
	brb_pid=""
	card_started=0
	card_image=""

	while true; do
		line="$(brb_tick "$provider")" || line=""
		# shellcheck disable=SC2086
		set -- $line
		verb="${1:-}"
		test "$verb" != stop || break
		test "$((SECONDS - entered))" -lt "$brb_max_seconds" || break

		if test -n "$brb_pid" && ! kill -0 "$brb_pid" 2>/dev/null; then
			# A card that dies this fast is a background FFmpeg cannot decode.
			# Falling back here is why the app never has to validate an upload.
			test -z "$card_image" ||
				test "$((SECONDS - card_started))" -ge 3 ||
				card_image="skip"
			brb_pid=""
		fi
		# An unreachable app leaves the current card running rather than
		# dropping a stream over a blip; the ceiling above still bounds it.
		if test -z "$brb_pid" && test "$verb" = brb; then
			if test "$card_image" = skip; then
				card_image=""
			elif prepare_card "${2:-}" "${3:--}" "${4:-color}" "$text_file" \
				"$image_file"; then
				card_image="$image_file"
			else
				card_image=""
			fi
			brb_card_ffmpeg "$destination" "$log" "$card_image" "${4:-color}" \
				"$text_file" &
			brb_pid="$!"
			card_started="$SECONDS"
			report_state "$provider" brb ""
		fi

		sleep "$brb_tick_seconds" &
		wait "$!"
		test "$resume" -eq 0 || break
	done

	if test -n "$brb_pid"; then
		kill "$brb_pid" 2>/dev/null
		wait "$brb_pid" 2>/dev/null
	fi
	brb_pid=""
	rm -f "$text_file" "$image_file"
	test "$resume" -eq 1
}

hook ready "{\"path\":\"$path\",\"sourceType\":\"$source_type\"}" || true

start_destinations() {
	local skip="" provider holder destinations role filter destination contract
	for provider in twitch kick youtube; do
		holder="$(lock_holder "$provider")" || continue
		test -n "$holder" || continue
		test -z "$skip" && skip="\"$provider\"" || skip="$skip,\"$provider\""
		# The publisher is back; drop the card and return to the live encode.
		kill -USR1 "$holder" 2>/dev/null || true
	done
	if destinations="$(
		curl --fail --silent --show-error --max-time 5 --request POST \
			--header "Content-Type: application/json" \
			--header "X-Hook-Secret: $HOOK_SECRET" \
			--data "{\"path\":\"$path\",\"skip\":[$skip]}" \
			"$app_url/api/hooks/direct-destinations-v2"
	)"; then
		contract=2
	else
		contract=1
		destinations="$(
			curl --fail --silent --show-error --max-time 5 --request POST \
				--header "Content-Type: application/json" \
				--header "X-Hook-Secret: $HOOK_SECRET" \
				--data "{\"path\":\"$path\",\"skip\":[$skip]}" \
				"$app_url/api/hooks/direct-destinations"
		)" || destinations=""
	fi
	if test "$contract" = 2; then
		while read -r provider role filter destination; do
			test -n "${provider:-}" -a -n "${destination:-}" || continue
			acquire_lock "$provider" || continue
			set -m
			forward "$provider" "$role" "$filter" "$destination" 1 &
			printf '%s\n' "$!" >"$(lock_dir "$provider")/pid"
			set +m
		done <<<"$destinations"
	else
		while read -r provider destination; do
			test -n "${provider:-}" -a -n "${destination:-}" || continue
			acquire_lock "$provider" || continue
			set -m
			forward "$provider" landscape - "$destination" 0 &
			printf '%s\n' "$!" >"$(lock_dir "$provider")/pid"
			set +m
		done <<<"$destinations"
	fi
}

start_destinations
while true; do
	# ponytail: 640 wide is a thumbnail budget, and it is also the BRB card's
	# background — raise it here if anyone wants a crisp card, the cost is
	# snapshot bandwidth on every live stream rather than encode.
	if timeout 20s ffmpeg -nostdin -hide_banner -loglevel error \
		-rtsp_transport tcp -i "rtsp://127.0.0.1:$RTSP_PORT/$path" \
		-vf "scale=640:-2" -frames:v 1 -q:v 5 -y "$snapshot_file" && \
		test -s "$snapshot_file"; then
		upload_url="$(
			curl --fail --silent --show-error --max-time 2 --request POST \
				--header "X-Hook-Secret: $HOOK_SECRET" \
				"$app_url/api/hooks/snapshot-upload/$path"
		)" || upload_url=""
		if test -n "$upload_url"; then
			curl --fail --silent --show-error --max-time 20 --request PUT \
				--header "Content-Type: image/jpeg" \
				--upload-file "$snapshot_file" \
				"$upload_url" || true
		fi
	fi
	sleep 60 &
	wait "$!"
done
