{$RELAY_DOMAIN} {
	@ping path /ping
	header @ping Access-Control-Allow-Origin "https://{$APP_DOMAIN}"
	header @ping Access-Control-Allow-Methods "GET, OPTIONS"
	header @ping Cache-Control "no-store"
	respond @ping 204

	reverse_proxy 127.0.0.1:8889
}

# Optional per-host extra vhosts (e.g. a staging relay). The directory must
# exist with at least one .caddy file; see deploy/STAGING.md.
import /etc/caddy/staging/*.caddy
