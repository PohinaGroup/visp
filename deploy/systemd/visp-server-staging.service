[Unit]
Description=VISP API (staging)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/visp-staging/apps/server
EnvironmentFile=/etc/visp-staging/app.env
# Node runs the tsdown bundle for the same TLS reason as production: Bun 1.3.x
# segfaults when node-postgres opens TLS to managed Postgres.
ExecStart=/usr/bin/node dist/index.mjs
Restart=always
RestartSec=2
StartLimitInterval=0

[Install]
WantedBy=multi-user.target
