[Unit]
Description=VISP Typography worker
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/visp/apps/server
EnvironmentFile=/etc/visp/app.env
ExecStart=/usr/bin/node dist/typography-worker.mjs
Restart=always
RestartSec=2
StartLimitInterval=0

[Install]
WantedBy=multi-user.target
