[Unit]
Description=MediaMTX relay (staging)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/visp-staging/relay.env
ExecStart=/usr/local/bin/mediamtx /etc/mediamtx/mediamtx-staging.yml
Restart=always
RestartSec=2
LimitNOFILE=1048576
# Separate runtime directory from the production relay unit so forwarder
# locks, publisher markers, and snapshot files never collide. visp-snapshot
# picks it up through VISP_RUN_DIR in the environment file.
RuntimeDirectory=visp-staging
RuntimeDirectoryMode=0700
# Highlight clips on disk, not tmpfs; see mediamtx.service.
CacheDirectory=visp-staging
CacheDirectoryMode=0700
ExecStartPre=-/usr/bin/find /var/cache/visp-staging -mindepth 1 -delete
KillMode=mixed

[Install]
WantedBy=multi-user.target
