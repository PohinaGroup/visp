# Staging vhosts. Imported from the main Caddyfile's
# `import /etc/caddy/staging/*.caddy` line, so this file only exists where a
# staging deployment was provisioned. Domains are literal on purpose: the
# caddy.env drop-in on the app box carries production values, and a shared
# variable name would leak between the two environments.

# Snippet names carry a staging_ prefix: this file is imported into the
# production Caddyfile, which defines its own, and is also validated alone.
(staging_security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

(staging_deny_framing) {
	header {
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
	}
}

# Mirrors api_body_limits in deploy/app/Caddyfile.
(staging_api_body_limits) {
	@json_api {
		path /api/* /trpc/* /.well-known/agent-configuration
		not path /api/audio-isolation /api/typography/*
	}
	request_body @json_api {
		max_size 1MiB
	}
	request_body /api/typography/* {
		max_size 8MiB
	}
	request_body /api/audio-isolation {
		max_size 64KiB
	}
}

staging.visp-stream.com {
	import staging_security_headers
	# The Studio editor previews the overlay and broadcast page on this origin.
	@overlay path /overlay /live /live/
	header @overlay {
		X-Frame-Options SAMEORIGIN
		Content-Security-Policy "frame-ancestors 'self'"
	}
	@not_overlay not path /overlay /live /live/
	header @not_overlay {
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
	}

	route {
		import staging_api_body_limits

		# Hooks arrive from the staging relay on this same box (loopback) or
		# from the box's own public address; the hook secret is checked by the
		# app regardless.
		@machine {
			path /api/mediamtx/auth /api/hooks/*
			remote_ip 127.0.0.1 87.58.145.161
		}
		handle @machine {
			reverse_proxy 127.0.0.1:3100
		}

		@blocked_machine path /api/mediamtx/auth /api/hooks/*
		handle @blocked_machine {
			respond 403
		}

		handle /api/auth/* {
			reverse_proxy 127.0.0.1:3100
		}
		handle /api/agent/* {
			reverse_proxy 127.0.0.1:3100
		}
		handle /.well-known/agent-configuration {
			reverse_proxy 127.0.0.1:3100
		}
		handle /trpc/* {
			reverse_proxy 127.0.0.1:3100
		}
		handle /api/chat/* {
			reverse_proxy 127.0.0.1:3100
		}
		handle /api/multichat/* {
			reverse_proxy 127.0.0.1:3100
		}
		handle /chat {
			redir https://multichat.staging.visp-stream.com/ 308
		}
		handle_path /chat/* {
			redir https://multichat.staging.visp-stream.com{uri} 308
		}
		handle /api/seppo {
			reverse_proxy 127.0.0.1:3100 {
				header_up X-Real-IP {remote_host}
			}
		}
		handle /api/obs/* {
			reverse_proxy 127.0.0.1:3100
		}
		handle /api/subtitles/token {
			reverse_proxy 127.0.0.1:3100
		}
		handle /api/typography/* {
			reverse_proxy 127.0.0.1:3100
		}
		handle /api/tts {
			reverse_proxy 127.0.0.1:3100
		}
		handle /api/audio-isolation {
			reverse_proxy 127.0.0.1:3100
		}
		handle /api/webhooks/* {
			reverse_proxy 127.0.0.1:3100
		}
		handle {
			reverse_proxy 127.0.0.1:3101
		}
	}
}

admin.staging.visp-stream.com {
	import staging_security_headers
	import staging_deny_framing
	root * /opt/visp-staging/apps/admin/dist
	encode zstd gzip
	try_files {path} /index.html
	file_server
}

typography.staging.visp-stream.com {
	import staging_security_headers
	import staging_deny_framing
	root * /opt/visp-staging/apps/typography/dist
	encode zstd gzip
	try_files {path} /index.html
	file_server
}

multichat.staging.visp-stream.com {
	import staging_security_headers
	# The overlay is an OBS browser source and may be previewed in the Cloud
	# Studio editor on the app origin; nothing else may frame it.
	header Content-Security-Policy "frame-ancestors https://staging.visp-stream.com"
	root * /opt/visp-staging/apps/multichat/dist
	encode zstd gzip
	try_files {path} /index.html
	file_server
}

stream.staging.visp-stream.com {
	import staging_security_headers
	import staging_deny_framing
	root * /opt/visp-staging/apps/native/dist
	encode zstd gzip
	try_files {path} /index.html
	file_server
}

remote.staging.visp-stream.com {
	import staging_security_headers
	import staging_deny_framing
	root * /opt/visp-staging/apps/obs-remote/dist
	encode zstd gzip
	try_files {path} /index.html
	file_server
}

docs.staging.visp-stream.com {
	import staging_security_headers
	import staging_deny_framing
	root * /opt/visp-staging/apps/fumadocs/.output/public
	encode zstd gzip

	handle /api/* {
		header Content-Type application/json
		file_server
	}

	handle {
		try_files {path} {path}/index.html /_shell.html
		file_server
	}
}
