# Staging relay vhost, imported by the app box's Caddy via
# /etc/caddy/staging/*.caddy. The staging MediaMTX runs on the app box itself
# with the same ingest ports as production (8890/5000/1935/8189) because
# publish URLs hardcode them; only the WHEP hostname differs.

relay-staging.visp-stream.com {
	# No frame denial: WHEP players and MediaMTX pages may be embedded.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	@ping path /ping
	header @ping Access-Control-Allow-Origin "*"
	header @ping Access-Control-Allow-Methods "GET, OPTIONS"
	header @ping Cache-Control "no-store"
	respond @ping 204

	reverse_proxy 127.0.0.1:8889
}
