AI_GATEWAY_API_KEY=
# Optional hosted text-to-speech, audio isolation, and captions.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
ADMIN_ORIGIN=https://admin.visp.localhost
# Optional Discord or Slack incoming webhook. Founding creator applications are
# posted here; unset means applications are only written to the database.
# APPLICATION_WEBHOOK_URL=
# Comma-separated Better Auth user IDs with break-glass admin access.
ADMIN_USER_IDS=
DATABASE_URL=postgresql://visp:visp@127.0.0.1:5432/visp
# Managed Postgres: install the provider CA into the system trust store
# (update-ca-certificates) and keep DATABASE_SSL_CA unset. Bun 1.3.x can
# segfault when a custom ssl.ca PEM is used in the same process as Bun.S3Client.
# Optional escape hatch only: DATABASE_SSL_CA=/etc/visp/upcloud-db-ca.crt
# DATABASE_SSL_CA=
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://api.visp.localhost
CORS_ORIGIN=https://visp.localhost
HOOK_SECRET=replace-with-at-least-32-random-characters
# Google OAuth for YouTube sign-in and Direct broadcasts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# iOS OAuth client for native Google Sign-In (bundle ID com.pohinagroup.visp).
# GOOGLE_IOS_CLIENT_ID=
# Android OAuth client for native Google Sign-In.
# GOOGLE_ANDROID_CLIENT_ID=
# Kick OAuth, app-token subscriptions, and signed chat webhooks.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Bootstrap-only values for the database-backed default relay.
MEDIAMTX_API_URL=http://127.0.0.1:9997
DIRECT_MAX_FORWARDERS=2
NATIVE_WEB_ORIGIN=http://127.0.0.1:8081
OBS_REMOTE_WEB_ORIGIN=http://localhost:8083
RELAY_HOST=relay.visp.localhost
RELAY_PING_URL=https://relay.visp.localhost/ping
# Active publishing paths allowed per user.
MAX_PATHS_PER_USER=10
S3_ACCESS_KEY_ID=visp
S3_BUCKET=visp-snapshots
S3_ENDPOINT=https://s3.visp.localhost
# Optional separate endpoint used only to presign relay snapshot uploads.
# S3_UPLOAD_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_SECRET_ACCESS_KEY=visp-local-secret
# Generate with: openssl rand -base64 32
PUBLISH_URL_ENCRYPTION_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
NODE_ENV=development
