	"scripts": {
		"eas-build-post-install": "bash -c 'case \"${EAS_BUILD_PLATFORM:-}\" in ios) modules/visp-srt/scripts/build-libsrt.sh ios ;; android) modules/visp-srt/scripts/build-libsrt.sh android ;; esac'",
		"android": "expo run:android --device",
		"build": "expo export --platform all",
		"build:android": "expo export --platform android",
		"build:web": "expo export --platform web",
		"check-types": "tsc --noEmit",
		"dev": "expo start --dev-client",
		"ios": "expo run:ios --device",
		"lint": "biome check src modules/visp-srt/src",
		"start": "expo start --dev-client",
		"test": "bun test src"
	},
	"private": true
