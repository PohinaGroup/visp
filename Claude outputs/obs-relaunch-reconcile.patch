From 198d39fa09627baed6aa738f2859f4abb09bd59b Mon Sep 17 00:00:00 2001
From: jonijuntto <joni@evenli.com>
Date: Mon, 12 Oct 2026 20:48:36 +0300
Subject: [PATCH] fix(obs-control): reconcile a relaunched OBS instead of
 restarting its last stream

A plugin restarts at applied version 0 when OBS is relaunched. Within the
queued-command TTL its first report was ignored as too old, so the reply
carried the previous session's desired flags (e.g. streaming, left behind
by a crash or a lost "stopped" report) and the plugin went live again.

The first report on a new OBS WebSocket at version 0 now lands when no
command is pending, so the desired flags follow what OBS reports. A
command still pending within the TTL is delivered as before. Covers old
plugins (<=1.9.2) as well, since the fix is server-side.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01DUjVne4K8kKV3EzRFQRn1w
---
 apps/server/src/machine.integration.test.ts | 124 ++++++++++++++++++++
 apps/server/src/obs-live.ts                 |  14 ++-
 packages/api/src/obs-control.ts             |  30 ++++-
 3 files changed, 164 insertions(+), 4 deletions(-)

diff --git a/apps/server/src/machine.integration.test.ts b/apps/server/src/machine.integration.test.ts
index 557be3b..2f9d442 100644
--- a/apps/server/src/machine.integration.test.ts
+++ b/apps/server/src/machine.integration.test.ts
@@ -1600,6 +1600,130 @@ integration("relay PostgreSQL integration", () => {
 		}
 	});
 
+	test("a relaunched OBS does not restart the previous session's stream", async () => {
+		await seed();
+		const pairing = await rotateObsControlToken("user-a");
+		const liveApp = new Elysia({ adapter: nodeAdapter }).use(obsLiveRoutes);
+		const liveServer = await new Promise<NonNullable<typeof liveApp.server>>(
+			(resolve) =>
+				liveApp.listen({ hostname: "127.0.0.1", port: 0 }, (server) =>
+					resolve(server),
+				),
+		);
+		const port = (
+			liveServer as unknown as {
+				raw?: { bun?: { server?: { address?: { port?: number } } } };
+			}
+		).raw?.bun?.server?.address?.port;
+		if (!port) throw new Error("OBS live test server did not start");
+		const connect = async () => {
+			const response = await fetch(
+				`http://127.0.0.1:${port}/api/obs/live-ticket`,
+				{
+					method: "POST",
+					headers: { authorization: `Bearer ${pairing.token}` },
+				},
+			);
+			const { ticket } = (await response.json()) as { ticket: string };
+			const socket = new WebSocket(
+				`ws://127.0.0.1:${port}/api/obs/live?ticket=${encodeURIComponent(ticket)}`,
+			);
+			const received: Record<string, unknown>[] = [];
+			const waiters: Array<(value: Record<string, unknown>) => void> = [];
+			socket.onmessage = ({ data }) => {
+				const value = JSON.parse(String(data)) as Record<string, unknown>;
+				const waiter = waiters.shift();
+				if (waiter) waiter(value);
+				else received.push(value);
+			};
+			await new Promise<void>((resolve, reject) => {
+				socket.onopen = () => resolve();
+				socket.onerror = () => reject(new Error("OBS WebSocket did not open"));
+			});
+			const next = () => {
+				const value = received.shift();
+				return value
+					? Promise.resolve(value)
+					: new Promise<Record<string, unknown>>((resolve) =>
+							waiters.push(resolve),
+						);
+			};
+			const report = (appliedVersion: number, streaming: boolean) => {
+				socket.send(
+					JSON.stringify({
+						appliedVersion,
+						streaming,
+						scenes: ["Main"],
+						currentScene: "Main",
+					}),
+				);
+				return next();
+			};
+			return { socket, next, report };
+		};
+		const closed = async (socket: WebSocket) => {
+			socket.close();
+			await new Promise((resolve) => setTimeout(resolve, 100));
+		};
+		try {
+			// OBS goes live from VISP and acknowledges it.
+			const first = await connect();
+			expect(await first.report(0, false)).toMatchObject({ commandVersion: 0 });
+			await setObsStreaming("user-a", true);
+			expect(await first.next()).toMatchObject({
+				commandVersion: 1,
+				desiredStreaming: true,
+			});
+			expect(await first.report(1, true)).toMatchObject({
+				commandVersion: 1,
+				desiredStreaming: true,
+			});
+			// OBS crashes (or its "stopped" report is lost on shutdown) and is
+			// reopened well within the queued-command TTL. The plugin starts again
+			// at version 0 and reports it is not streaming: the reply must follow
+			// that, not carry the old session's "streaming" back to start it again.
+			await closed(first.socket);
+			const relaunched = await connect();
+			expect(await relaunched.report(0, false)).toMatchObject({
+				commandVersion: 1,
+				desiredStreaming: false,
+			});
+			expect(await getObsControlStatus("user-a")).toMatchObject({
+				desiredStreaming: false,
+				pending: false,
+			});
+			// Only the first report of a connection is a relaunch: a later report
+			// at version 0 on it is still too old to land.
+			await setObsStreaming("user-a", true);
+			expect(await relaunched.next()).toMatchObject({
+				commandVersion: 2,
+				desiredStreaming: true,
+			});
+			expect(await relaunched.report(2, true)).toMatchObject({
+				commandVersion: 2,
+				desiredStreaming: true,
+			});
+			expect(await relaunched.report(0, false)).toMatchObject({
+				commandVersion: 2,
+				desiredStreaming: true,
+			});
+			await relaunched.report(2, false);
+
+			// A Go Live pressed while OBS was closed, shortly before opening it,
+			// is still a pending command and is still delivered.
+			await closed(relaunched.socket);
+			await setObsStreaming("user-a", true);
+			const opened = await connect();
+			expect(await opened.report(0, false)).toMatchObject({
+				commandVersion: 3,
+				desiredStreaming: true,
+			});
+			await closed(opened.socket);
+		} finally {
+			liveServer.stop(true);
+		}
+	});
+
 	test("keeps two accounts' OBS WebSockets separate", async () => {
 		await seed();
 		const pairingA = await rotateObsControlToken("user-a");
diff --git a/apps/server/src/obs-live.ts b/apps/server/src/obs-live.ts
index 0e14ccf..2407fac 100644
--- a/apps/server/src/obs-live.ts
+++ b/apps/server/src/obs-live.ts
@@ -14,7 +14,13 @@ import { nodeAdapter, socketKey } from "./node-adapter";
 
 const connections = new Map<
 	string,
-	{ peer: ObsLivePeer; reports: Promise<void>; unsubscribe: () => void }
+	{
+		peer: ObsLivePeer;
+		reports: Promise<void>;
+		unsubscribe: () => void;
+		/** A state report has been received on this connection. */
+		reported: boolean;
+	}
 >();
 
 function send(ws: { send(data: string): unknown }, data: unknown) {
@@ -82,6 +88,7 @@ export const obsLiveRoutes = new Elysia({
 				peer,
 				reports: Promise.resolve(),
 				unsubscribe,
+				reported: false,
 			});
 
 			try {
@@ -110,12 +117,17 @@ export const obsLiveRoutes = new Elysia({
 				ws.close(1008, "Only an OBS machine may report state");
 				return;
 			}
+			// Decided on arrival, not when the queued report runs, so only the
+			// connection's very first message counts.
+			const firstOnConnection = !connection.reported;
+			connection.reported = true;
 			connection.reports = connection.reports.then(async () => {
 				try {
 					const command = await reportObsControlState(
 						peer.userId,
 						peer.tokenId,
 						message,
+						{ firstOnConnection },
 					);
 					if (!command) {
 						ws.close(1008, "OBS credential was revoked");
diff --git a/packages/api/src/obs-control.ts b/packages/api/src/obs-control.ts
index 7f02a6c..7d8c341 100644
--- a/packages/api/src/obs-control.ts
+++ b/packages/api/src/obs-control.ts
@@ -293,7 +293,14 @@ export async function reportObsControlState(
 	userId: string,
 	tokenId: string,
 	input: ObsStateReportInput,
-	now = Date.now(),
+	{
+		now = Date.now(),
+		firstOnConnection = false,
+	}: {
+		now?: number;
+		/** First report on a newly opened OBS WebSocket. */
+		firstOnConnection?: boolean;
+	} = {},
 ) {
 	const recording = input.recording ?? false;
 	const virtualCam = input.virtualCam ?? false;
@@ -303,6 +310,18 @@ export async function reportObsControlState(
 	// seen): whatever is still unapplied is expired and the desired flags are
 	// reconciled with what OBS reports now.
 	const queueExpired = sql`(${appUser.obsLastSeenAt} is null or ${appUser.obsLastSeenAt} < ${new Date(now - OBS_QUEUED_COMMAND_TTL_MS).toISOString()}::timestamptz)`;
+	// A plugin keeps its applied version across reconnects, so the first report
+	// of a connection at version 0 is a freshly started plugin (OBS relaunched,
+	// or the plugin restarted after a settings change). If nothing is pending,
+	// the desired flags only mirror what the previous OBS session was doing (a
+	// stream that was live when OBS crashed, or whose "stopped" report was lost
+	// on shutdown). That report must land so they follow the actual state now,
+	// or the reply would carry them back and start that stream again. A command
+	// still pending within the TTL is left alone and delivered as before.
+	const relaunchedWithNothingPending =
+		firstOnConnection && input.appliedVersion === 0
+			? sql`${appUser.obsAppliedVersion} >= ${appUser.obsCommandVersion}`
+			: sql`false`;
 	const appliedVersion = sql<number>`case when ${queueExpired} then ${appUser.obsCommandVersion} else greatest(${appUser.obsAppliedVersion}, least(${input.appliedVersion}, ${appUser.obsCommandVersion})) end`;
 	// Once the plugin has caught up, each desired flag follows the reported
 	// actual so a manual change in OBS is never fought (same idea as the scene).
@@ -352,8 +371,13 @@ export async function reportObsControlState(
 				// A report older than one already applied is ignored so it cannot
 				// roll the actual state back, but a relaunched OBS reports version 0
 				// again: once the queue has expired its report must land, or the
-				// expired command is never reconciled and still fires.
-				or(lte(appUser.obsAppliedVersion, input.appliedVersion), queueExpired),
+				// expired command is never reconciled and still fires. The same goes
+				// for a relaunch with nothing pending, whatever the queue's age.
+				or(
+					lte(appUser.obsAppliedVersion, input.appliedVersion),
+					queueExpired,
+					relaunchedWithNothingPending,
+				),
 			),
 		)
 		.returning();
