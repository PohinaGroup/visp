{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalPassThroughEnv": [
		"CHROMIUM_BIN",
		"PLAYWRIGHT_ADMIN_URL",
		"PLAYWRIGHT_DOCS_URL",
		"PLAYWRIGHT_ISOLATED_PORTAL",
		"PLAYWRIGHT_ISOLATED_TYPOGRAPHY",
		"PLAYWRIGHT_PORTAL_URL",
		"PLAYWRIGHT_SKIP_HEALTHCHECK",
		"PLAYWRIGHT_TYPOGRAPHY_URL",
		"HOOK_SECRET",
		"STUDIO_FPS",
		"STUDIO_FIFO_PACKETS",
		"STUDIO_CRF",
		"STUDIO_MAXRATE",
		"STUDIO_BUFSIZE",
		"STUDIO_GOP",
		"STUDIO_MEDIA_PASSWORD",
		"STUDIO_MEDIA_USER",
		"STUDIO_WORKER_TOKEN",
		"STUDIO_VIDEO_ENCODER"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": [
				"EXPO_PUBLIC_SERVER_URL",
				"VITE_SERVER_URL",
				"VITE_RYBBIT_SITE_ID"
			],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".output/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"env": ["EXPO_PUBLIC_SERVER_URL"],
			"persistent": true
		},
		"db:push": {
			"cache": false
		},
		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false,
			"passThroughEnv": ["DATABASE_URL", "DATABASE_SSL_CA"]
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		}
	}
}
