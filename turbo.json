{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": [
				"EXPO_PUBLIC_SERVER_URL",
				"VITE_SERVER_URL",
				"VITE_RYBBIT_SITE_ID"
			],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".output/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"env": ["EXPO_PUBLIC_SERVER_URL"],
			"persistent": true
		},
		"db:push": {
			"cache": false
		},
		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false,
			"passThroughEnv": ["DATABASE_URL", "DATABASE_SSL_CA"]
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		}
	}
}
